<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
    <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />

    <children>
        <!-- Solid Deep Charcoal Background (1920x1080) -->
        <Rectangle
            id="background"
            width="1920"
            height="1080"
            color="0x0A0C10FF" />

        <!-- Dual Full-Screen Photo Posters with Strict 1080p Texture Caps for 200+ Photo Stability -->
        <Poster
            id="posterA"
            width="1920"
            height="1080"
            loadWidth="1920"
            loadHeight="1080"
            loadDisplayMode="scaleToFit"
            opacity="1.0" />

        <Poster
            id="posterB"
            width="1920"
            height="1080"
            loadWidth="1920"
            loadHeight="1080"
            loadDisplayMode="scaleToFit"
            opacity="0.0" />

        <!-- Smooth 1.5s Crossfade Animation: Poster A -> Poster B -->
        <Animation
            id="fadeAtoB"
            duration="1.5"
            easeFunction="linear">
            <FloatFieldInterpolator
                id="interpAOut"
                key="[0.0, 1.0]"
                keyValue="[1.0, 0.0]"
                fieldToInterp="posterA.opacity" />
            <FloatFieldInterpolator
                id="interpBIn"
                key="[0.0, 1.0]"
                keyValue="[0.0, 1.0]"
                fieldToInterp="posterB.opacity" />
        </Animation>

        <!-- Smooth 1.5s Crossfade Animation: Poster B -> Poster A -->
        <Animation
            id="fadeBtoA"
            duration="1.5"
            easeFunction="linear">
            <FloatFieldInterpolator
                id="interpBOut"
                key="[0.0, 1.0]"
                keyValue="[1.0, 0.0]"
                fieldToInterp="posterB.opacity" />
            <FloatFieldInterpolator
                id="interpAIn"
                key="[0.0, 1.0]"
                keyValue="[0.0, 1.0]"
                fieldToInterp="posterA.opacity" />
        </Animation>

        <!-- Fallback Empty Folder Notice (Shown only if pkg:/images/ has no family photos) -->
        <Group id="emptyStateGroup" visible="false">
            <Rectangle
                translation="[210, 260]"
                width="1500"
                height="420"
                color="0xFFD54FFF" />
            <Rectangle
                translation="[216, 266]"
                width="1488"
                height="408"
                color="0x10141DF5" />
            <Label
                id="emptyTitleLabel"
                translation="[260, 315]"
                width="1400"
                height="70"
                font="font:LargeBoldSystemFont"
                color="0xFFD54FFF"
                horizAlign="center"
                text="Welcome to Family Frame &amp; Radio" />
            <Label
                id="emptyBodyLabel"
                translation="[260, 405]"
                width="1400"
                height="150"
                font="font:MediumBoldSystemFont"
                color="0xFFFFFFFF"
                horizAlign="center"
                wrap="true"
                text="Your live radio is playing below! To add 200+ family photos, drop .jpg or .png photos into the images/ folder, re-zip, and sideload." />
            <Label
                id="emptyHintLabel"
                translation="[260, 575]"
                width="1400"
                height="60"
                font="font:MediumSystemFont"
                color="0x80DEEAFF"
                horizAlign="center"
                text="Press UP or DOWN on your remote anytime to change the radio genre!" />
        </Group>

        <!-- Big, Friendly Living-Room Clock & Date (Top-Right Corner) -->
        <Group id="clockGroup" translation="[1484, 34]">
            <Rectangle
                width="392"
                height="112"
                color="0xFFD54FFF" />
            <Rectangle
                translation="[4, 4]"
                width="384"
                height="104"
                color="0x0B0E17DE" />
            <Label
                id="clockTimeLabel"
                translation="[18, 12]"
                width="348"
                height="54"
                font="font:LargeBoldSystemFont"
                color="0xFFFFFFFF"
                horizAlign="right"
                text="12:00 PM" />
            <Label
                id="clockDateLabel"
                translation="[18, 66]"
                width="348"
                height="32"
                font="font:SmallBoldSystemFont"
                color="0xFFD54FFF"
                horizAlign="right"
                text="Saturday, Nov 14" />
        </Group>

        <!-- Grandparent-Friendly Top Radio Dial Banner (Appears on Genre/Station Change) -->
        <Group id="toastGroup" translation="[260, 44]" visible="false">
            <!-- Outer Gold Frame -->
            <Rectangle
                width="1400"
                height="174"
                color="0xFFD54FFF" />
            <!-- High-Contrast Dark Interior -->
            <Rectangle
                translation="[6, 6]"
                width="1388"
                height="162"
                color="0x0B0E17F4" />
            <!-- Line 1: Genre Number & Category -->
            <Label
                id="toastTitleLabel"
                translation="[40, 20]"
                width="1320"
                height="44"
                font="font:MediumBoldSystemFont"
                color="0xFFD54FFF"
                horizAlign="center"
                text="GENRE 1 OF 10  •  CHRISTIAN &amp; ENCOURAGING" />
            <!-- Line 2: Extra-Large Station Name -->
            <Label
                id="toastMessageLabel"
                translation="[40, 68]"
                width="1320"
                height="54"
                font="font:LargeBoldSystemFont"
                color="0xFFFFFFFF"
                horizAlign="center"
                text="100.3 K-LOVE Los Angeles" />
            <!-- Line 3: Gentle Sub-Hint -->
            <Label
                id="toastSubLabel"
                translation="[40, 126]"
                width="1320"
                height="34"
                font="font:SmallestBoldSystemFont"
                color="0xB0BEC5FF"
                horizAlign="center"
                text="Press [UP / DOWN] to Change Genre   •   Press [ * ] for Next Station in This Genre" />
        </Group>

        <!-- Accessible High-Contrast Bottom HUD Bar (10-Foot Grandparent Design) -->
        <Group id="hudGroup" translation="[0, 884]">
            <!-- Deep High-Contrast Bar Background -->
            <Rectangle
                width="1920"
                height="196"
                color="0x080B11E8" />
            <!-- Warm Gold Top Accent Strip -->
            <Rectangle
                width="1920"
                height="6"
                color="0xFFD54FFF" />

            <!-- Left Section: Family Photo Album Counter & Order Mode -->
            <Label
                id="photoHeaderLabel"
                translation="[56, 16]"
                width="620"
                height="32"
                font="font:SmallestBoldSystemFont"
                color="0xFFD54FFF"
                horizAlign="left"
                text="FAMILY PHOTO ALBUM  •  STORYBOOK ORDER" />
            <Label
                id="photoCounterLabel"
                translation="[56, 46]"
                width="620"
                height="52"
                font="font:LargeBoldSystemFont"
                color="0xFFFFFFFF"
                horizAlign="left"
                text="Photo 1 of 1" />
            <Label
                id="photoSubLabel"
                translation="[56, 98]"
                width="620"
                height="32"
                font="font:SmallBoldSystemFont"
                color="0xB0BEC5FF"
                horizAlign="left"
                text="Auto-Advance: Every 12s" />

            <!-- Right Section: Current Genre, Radio Station & Live Song -->
            <Label
                id="radioHeaderLabel"
                translation="[680, 16]"
                width="1184"
                height="32"
                font="font:SmallestBoldSystemFont"
                color="0x80DEEAFF"
                horizAlign="right"
                text="GENRE 1 OF 10  •  CHRISTIAN &amp; ENCOURAGING" />
            <Label
                id="radioStatusLabel"
                translation="[680, 46]"
                width="1184"
                height="50"
                font="font:MediumBoldSystemFont"
                color="0xFFD54FFF"
                horizAlign="right"
                text="100.3 K-LOVE Los Angeles" />
            <Label
                id="nowPlayingLabel"
                translation="[680, 98]"
                width="1184"
                height="32"
                font="font:SmallBoldSystemFont"
                color="0xA5D6A7FF"
                horizAlign="right"
                text="" />

            <!-- Subtle Horizontal Divider -->
            <Rectangle
                translation="[56, 138]"
                width="1808"
                height="2"
                color="0xFFFFFF26" />

            <!-- Bottom Row: Easy-to-Read Remote Button Guide -->
            <Label
                id="controlsHintLabel"
                translation="[40, 148]"
                width="1840"
                height="40"
                font="font:SmallBoldSystemFont"
                color="0xEEEEEEFF"
                horizAlign="center"
                text="[Left/Right] Photo  |  [Rew/FF] ±10  |  [Up/Down] Genre (1-10)  |  [*] Station  |  [OK] Shuffle  |  [Play] Pause  |  [Replay] Mute" />
        </Group>

        <!-- Slideshow Auto-Advance Timer (12 Seconds) -->
        <Timer
            id="slideshowTimer"
            repeat="true"
            duration="12.0" />

        <!-- Toast Auto-Hide Timer (6 Seconds for Easy Reading) -->
        <Timer
            id="toastTimer"
            repeat="false"
            duration="6.0" />

        <!-- Living-Room Clock Refresh Timer (Every 15 Seconds) -->
        <Timer
            id="clockTimer"
            repeat="true"
            duration="15.0" />

        <!-- Background Audio Node for Live Radio Streams -->
        <Audio id="radioPlayer" />
    </children>
</component>
