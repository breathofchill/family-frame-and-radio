' =============================================================================
' TriviaCatalog.brs — 100 Wholesome Family Trivia, History & Brain-Fitness Cards
' 5 Heartwarming Categories (20 Cards per Category = 100 Total Cards)
' =============================================================================

function get100FamilyTriviaCards() as Object
    return [
        { id: 1, cat: "THIS DAY IN HISTORY", topic: "The Golden Gate Bridge", fact: "Construction of San Francisco's Golden Gate Bridge finished ahead of schedule in 1937, despite gale-force Pacific winds and heavy fog." },
        { id: 2, cat: "THIS DAY IN HISTORY", topic: "Apollo Moon Landing", fact: "Over 650 million people worldwide watched Neil Armstrong take humanity's first steps on the Moon in July 1969." },
        { id: 3, cat: "THIS DAY IN HISTORY", topic: "Route 66 Established", fact: "Known as the 'Mother Road', US Route 66 was commissioned in 1926, spanning 2,448 miles from Chicago to Santa Monica." },
        { id: 4, cat: "THIS DAY IN HISTORY", topic: "The Model T Debut", fact: "Henry Ford introduced the Model T in October 1908. By 1927, over 15 million had rolled off the world's first moving assembly line." },
        { id: 5, cat: "THIS DAY IN HISTORY", topic: "Grand Canyon National Park", fact: "President Woodrow Wilson signed the act creating Grand Canyon National Park in 1919, protecting 1.2 million acres of ancient red rock." },
        { id: 6, cat: "THIS DAY IN HISTORY", topic: "First Transcontinental Railroad", fact: "The Golden Spike was driven at Promontory Summit, Utah in 1869, uniting the Central Pacific and Union Pacific railroads." },
        { id: 7, cat: "THIS DAY IN HISTORY", topic: "Statue of Liberty Dedication", fact: "A gift of friendship from France, Lady Liberty was officially dedicated in New York Harbor in October 1886." },
        { id: 8, cat: "THIS DAY IN HISTORY", topic: "The Panama Canal Opens", fact: "The 51-mile canal opened in August 1914, cutting the journey between the Atlantic and Pacific oceans by nearly 8,000 nautical miles." },
        { id: 9, cat: "THIS DAY IN HISTORY", topic: "Mount Rushmore Finished", fact: "Sculptor Gutzon Borglum and 400 workers carved the 60-foot heads of four presidents between 1927 and 1941 without a single fatality." },
        { id: 10, cat: "THIS DAY IN HISTORY", topic: "First Commercial Radio Broadcast", fact: "KDKA in Pittsburgh made the world's first commercial broadcast in November 1920, announcing the Harding-Cox presidential election results." },
        { id: 11, cat: "THIS DAY IN HISTORY", topic: "The Hoover Dam Complete", fact: "Rising 726 feet above the Colorado River, the Hoover Dam was completed in 1936, two full years ahead of schedule." },
        { id: 12, cat: "THIS DAY IN HISTORY", topic: "Wright Brothers' First Flight", fact: "Orville and Wilbur Wright achieved the first sustained powered flight at Kitty Hawk, North Carolina on December 17, 1903." },
        { id: 13, cat: "THIS DAY IN HISTORY", topic: "Yellowstone: World's First Park", fact: "President Ulysses S. Grant signed Yellowstone National Park into law in 1872, creating the world's very first national park." },
        { id: 14, cat: "THIS DAY IN HISTORY", topic: "The Lincoln Memorial Dedication", fact: "Dedicated on Memorial Day in 1922, the 19-foot seated marble statue of Abraham Lincoln took sculptor Daniel Chester French four years to carve." },
        { id: 15, cat: "THIS DAY IN HISTORY", topic: "Disneyland Grand Opening", fact: "Walt Disney opened his Anaheim theme park on July 17, 1955, welcoming guests into Main Street, U.S.A. and Fantasyland." },
        { id: 16, cat: "THIS DAY IN HISTORY", topic: "First Coast-to-Coast Phone Call", fact: "Alexander Graham Bell in New York spoke to Dr. Thomas Watson in San Francisco in January 1915 over 3,400 miles of wire." },
        { id: 17, cat: "THIS DAY IN HISTORY", topic: "Mount Everest Summited", fact: "Sir Edmund Hillary and Sherpa Tenzing Norgay became the first verified climbers to reach Earth's summit on May 29, 1953." },
        { id: 18, cat: "THIS DAY IN HISTORY", topic: "The Empire State Building", fact: "Completed in just 1 year and 45 days in 1931, the 102-story skyscraper remained the world's tallest building for nearly 40 years." },
        { id: 19, cat: "THIS DAY IN HISTORY", topic: "The First Color Television", fact: "The Tournament of Roses Parade was broadcast in full color across the United States for the first time on New Year's Day 1954." },
        { id: 20, cat: "THIS DAY IN HISTORY", topic: "The Pony Express Begins", fact: "In April 1860, young riders on fast horses began carrying mail across 1,900 miles of wilderness in an astonishing 10 days." },
        { id: 21, cat: "BRAIN-FITNESS RIDDLE", topic: "What Goes Up?", fact: "Riddle: What goes up but never comes back down? Answer: Your age! Every single day adds a little more wisdom." },
        { id: 22, cat: "BRAIN-FITNESS RIDDLE", topic: "The Traveler", fact: "Riddle: What can travel all around the world while staying in one corner? Answer: A postage stamp on a postcard to family." },
        { id: 23, cat: "BRAIN-FITNESS RIDDLE", topic: "Keys with No Locks", fact: "Riddle: What has 88 keys, but cannot unlock a single door? Answer: A grand piano making sweet music in the living room!" },
        { id: 24, cat: "BRAIN-FITNESS WORDPLAY", topic: "The Only 15-Letter Word", fact: "The word 'UNCOPYRIGHTABLE' is the longest commonly used English word with 15 letters that contains zero repeating characters." },
        { id: 25, cat: "BRAIN-FITNESS RIDDLE", topic: "Full of Holes", fact: "Riddle: What is full of holes, yet can hold plenty of water? Answer: A kitchen sponge!" },
        { id: 26, cat: "BRAIN-FITNESS RIDDLE", topic: "Follows You Everywhere", fact: "Riddle: What is always right in front of you, but can never be seen? Answer: The future, full of beautiful sunny tomorrows." },
        { id: 27, cat: "BRAIN-FITNESS WORDPLAY", topic: "Pangram Wonder", fact: "A sentence using every letter of the alphabet is called a pangram: 'The quick brown fox jumps over the lazy dog.'" },
        { id: 28, cat: "BRAIN-FITNESS RIDDLE", topic: "A Friendly River", fact: "Riddle: What has a bed but never sleeps, and has a mouth but never speaks? Answer: A peaceful flowing river." },
        { id: 29, cat: "BRAIN-FITNESS RIDDLE", topic: "Gets Wetter as It Dries", fact: "Riddle: What gets wetter and wetter the more it dries? Answer: A warm bath towel fresh from the linen closet." },
        { id: 30, cat: "BRAIN-FITNESS WORDPLAY", topic: "Palindromes", fact: "'RACECAR', 'KAYAK', and 'MADAM, I'M ADAM' read identically forwards and backwards. The word for this is a palindrome." },
        { id: 31, cat: "BRAIN-FITNESS RIDDLE", topic: "Light as a Feather", fact: "Riddle: What is as light as a feather, yet the strongest person cannot hold it for more than a few minutes? Answer: Their breath!" },
        { id: 32, cat: "BRAIN-FITNESS RIDDLE", topic: "Runs Without Legs", fact: "Riddle: What has hands and a face, but cannot hold anything or smile? Answer: An antique mantle clock keeping time." },
        { id: 33, cat: "BRAIN-FITNESS WORDPLAY", topic: "The Shortest Complete Sentence", fact: "The shortest grammatically complete sentence in the English language is just two letters: 'Go!' (or 'I am.')" },
        { id: 34, cat: "BRAIN-FITNESS RIDDLE", topic: "Broken to Be Used", fact: "Riddle: What has to be broken before you can ever use it? Answer: An egg for Sunday morning pancakes!" },
        { id: 35, cat: "BRAIN-FITNESS RIDDLE", topic: "Belongs to You", fact: "Riddle: What belongs to you, but everyone else uses it far more than you do? Answer: Your name!" },
        { id: 36, cat: "BRAIN-FITNESS WORDPLAY", topic: "Bookkeeper's Triple Pair", fact: "The word 'BOOKKEEPER' (and 'bookkeeping') is the only English word with three consecutive double letters: oo, kk, and ee." },
        { id: 37, cat: "BRAIN-FITNESS RIDDLE", topic: "Head and Tail", fact: "Riddle: What has a head and a tail, but no body or legs? Answer: A shiny silver coin tossed into a wishing well." },
        { id: 38, cat: "BRAIN-FITNESS RIDDLE", topic: "Shaved Many Times", fact: "Riddle: A barber shaves twenty men every day, yet he still has a full beard. How? Answer: He is shaving other people!" },
        { id: 39, cat: "BRAIN-FITNESS WORDPLAY", topic: "The Letter E", fact: "The letter 'E' is the most frequently used letter in the English language, appearing in roughly 11% of all words." },
        { id: 40, cat: "BRAIN-FITNESS RIDDLE", topic: "Catcher of Wind", fact: "Riddle: I have branches, but no fruit, trunk, or leaves. What am I? Answer: A reliable bank, or a grand family tree!" },
        { id: 41, cat: "NATURE & WONDER", topic: "Hummingbird Acrobatics", fact: "Hummingbirds are the only birds capable of flying backwards, upside-down, and hovering motionless in mid-air." },
        { id: 42, cat: "NATURE & WONDER", topic: "Sea Otter Hand-Holding", fact: "Sea otters hold hands while floating asleep so they do not drift apart on the ocean waves." },
        { id: 43, cat: "NATURE & WONDER", topic: "Honey That Lasts Forever", fact: "Pure honey never spoils. Archaeologists have discovered edible pots of honey in ancient Egyptian tombs over 3,000 years old." },
        { id: 44, cat: "NATURE & WONDER", topic: "Monarch Butterfly Journey", fact: "Monarch butterflies migrate up to 3,000 miles every autumn, navigating with a sun compass and magnetic receptors in their antennae." },
        { id: 45, cat: "NATURE & WONDER", topic: "Gentle Giants of the Forest", fact: "California's General Sherman sequoia is the world's largest living tree by volume, standing 275 feet tall with a 36-foot trunk." },
        { id: 46, cat: "NATURE & WONDER", topic: "Elephant Empathy", fact: "Elephants have remarkable memories and show empathy, consoling distressed friends by stroking them gently with their trunks." },
        { id: 47, cat: "NATURE & WONDER", topic: "Starfish Regeneration", fact: "If a sea star loses an arm, it can grow a complete replacement over a few months, and some can even grow a whole body from one arm." },
        { id: 48, cat: "NATURE & WONDER", topic: "The Sweet Blue Jay", fact: "Blue jays bury thousands of acorns and beechnuts each autumn, helping reforest vast oak woodlands across North America." },
        { id: 49, cat: "NATURE & WONDER", topic: "Firefly Light Show", fact: "Fireflies produce 100% cold light through a gentle chemical reaction where nearly zero energy is wasted as heat." },
        { id: 50, cat: "NATURE & WONDER", topic: "Sunflower Sun-Followers", fact: "Young sunflowers practice heliotropism, turning their cheerful yellow blooms from east to west every day to follow the sun." },
        { id: 51, cat: "NATURE & WONDER", topic: "Dolphins with Names", fact: "Bottlenose dolphins use unique signature whistles that act just like human names to call and greet specific family members." },
        { id: 52, cat: "NATURE & WONDER", topic: "Oldest Living Organism", fact: "A bristlecone pine named 'Methuselah' in California's White Mountains has been alive for over 4,850 years." },
        { id: 53, cat: "NATURE & WONDER", topic: "Robin's Red Breast", fact: "American robins have exceptional vision, detecting the faint vibrations of earthworms in the morning grass before dawn." },
        { id: 54, cat: "NATURE & WONDER", topic: "Whale Song Across Oceans", fact: "Humpback whale songs can travel hundreds of miles through deep underwater sound channels, like an ocean symphony." },
        { id: 55, cat: "NATURE & WONDER", topic: "Busy Honeybees", fact: "A honeybee visits between 50 and 100 flowers during a single collection flight, beating her wings 200 times per second." },
        { id: 56, cat: "NATURE & WONDER", topic: "Polar Bear Fur Mystery", fact: "A polar bear's fur is not white! Each hair is actually a clear, hollow tube that reflects sunlight and traps warming heat." },
        { id: 57, cat: "NATURE & WONDER", topic: "Acorn Woodpecker Pantry", fact: "Acorn woodpeckers work together as a family to store thousands of acorns in a single 'granary tree' drilled with neat holes." },
        { id: 58, cat: "NATURE & WONDER", topic: "Morning Dew Magic", fact: "Morning dew forms when surfaces cool down beneath the dew point, creating miniature sparkling water droplets on garden petals." },
        { id: 59, cat: "NATURE & WONDER", topic: "Penguin Courtship Pebble", fact: "Gentoo penguins search an entire stony beach to present their partner with the single smoothest pebble as a courtship gift." },
        { id: 60, cat: "NATURE & WONDER", topic: "Snowflake Uniqueness", fact: "Because each snowflake takes a unique path through cold cloud temperatures and moisture, no two flakes have identical crystal branches." },
        { id: 61, cat: "NOSTALGIA & INVENTIONS", topic: "The Drive-In Theater", fact: "Richard Hollingshead opened the first drive-in movie theater in Camden, New Jersey in 1933 so families could watch movies under the stars." },
        { id: 62, cat: "NOSTALGIA & INVENTIONS", topic: "The Jukebox Era", fact: "By the mid-1950s, over 500,000 gleaming neon jukeboxes like the Wurlitzer 1015 were spinning vinyl 45s in diners across the nation." },
        { id: 63, cat: "NOSTALGIA & INVENTIONS", topic: "Origin of the Ice Cream Cone", fact: "At the 1904 St. Louis World's Fair, an ice cream vendor who ran out of bowls teamed up with a waffle maker to roll the first edible cones." },
        { id: 64, cat: "NOSTALGIA & INVENTIONS", topic: "The Slinky Toy Accident", fact: "Naval engineer Richard James accidentally dropped a tension spring in 1943. Watching it walk across his workbench, a classic toy was born." },
        { id: 65, cat: "NOSTALGIA & INVENTIONS", topic: "The Rotary Telephone", fact: "Almon Strowger invented the automatic rotary telephone dial in 1891 so callers could reach neighbors directly without an operator board." },
        { id: 66, cat: "NOSTALGIA & INVENTIONS", topic: "The Yellow School Bus", fact: "In 1939, educators standardized 'National School Bus Glossy Yellow' because black lettering stands out most vividly against it in early dawn." },
        { id: 67, cat: "NOSTALGIA & INVENTIONS", topic: "The First Chocolate Chip Cookie", fact: "Ruth Wakefield chopped a Nestlé chocolate bar into butter drop cookie dough at the Toll House Inn in Massachusetts in 1938." },
        { id: 68, cat: "NOSTALGIA & INVENTIONS", topic: "Scrabble in the Great Depression", fact: "Out-of-work architect Alfred Butts studied the front page of The New York Times to calculate letter frequencies and invent Scrabble in 1938." },
        { id: 69, cat: "NOSTALGIA & INVENTIONS", topic: "The Thermos Bottle", fact: "Sir James Dewar invented the vacuum flask in 1892, keeping a worker's hot vegetable soup steaming all morning long." },
        { id: 70, cat: "NOSTALGIA & INVENTIONS", topic: "The Farmall Red Tractor", fact: "International Harvester painted its tractors bright red starting in 1936 as a highway safety feature that quickly became an American icon." },
        { id: 71, cat: "NOSTALGIA & INVENTIONS", topic: "The Toaster Timer", fact: "Charles Strite patented the pop-up toaster with a built-in spring and variable timer in 1921, saving millions of breakfast toasts from burning." },
        { id: 72, cat: "NOSTALGIA & INVENTIONS", topic: "Band-Aid Invention", fact: "Earle Dickson invented the Band-Aid in 1920 so his wife Josephine could easily dress kitchen burns and cuts by herself." },
        { id: 73, cat: "NOSTALGIA & INVENTIONS", topic: "Crayola's Original Eight", fact: "Binney & Smith introduced the first 5-cent box of Crayola crayons in 1903 with eight colors: red, yellow, blue, green, orange, black, brown, violet." },
        { id: 74, cat: "NOSTALGIA & INVENTIONS", topic: "The Brownie Camera", fact: "Eastman Kodak released the $1 Brownie camera in 1900, putting snapshot photography into the hands of ordinary families for the first time." },
        { id: 75, cat: "NOSTALGIA & INVENTIONS", topic: "The First Polar Bear Club", fact: "The Coney Island Polar Bear Club was founded in 1903 by Bernarr Macfadden, who believed swimming in winter Atlantic waves revitalized health." },
        { id: 76, cat: "NOSTALGIA & INVENTIONS", topic: "The Magic of Silly Putty", fact: "Invented as a wartime synthetic rubber substitute, Silly Putty became a sensation when Peter Hodgson packaged it in plastic eggs in 1950." },
        { id: 77, cat: "NOSTALGIA & INVENTIONS", topic: "The Tupperware Revolution", fact: "Earl Tupper created flexible polyethylene bowls with patented 'burping' airtight seals in 1946, transforming pantry storage forever." },
        { id: 78, cat: "NOSTALGIA & INVENTIONS", topic: "The First Supermarket", fact: "Michael Cullen opened the 'King Kullen' grocery in Queens, New York in 1930, introducing the world's very first self-service shopping carts." },
        { id: 79, cat: "NOSTALGIA & INVENTIONS", topic: "Lego Wooden Beginnings", fact: "Danish carpenter Ole Kirk Christiansen began hand-carving wooden pull toys in 1932 before developing the famous interlocking plastic bricks in 1949." },
        { id: 80, cat: "NOSTALGIA & INVENTIONS", topic: "The Cozy Diner Booth", fact: "Classic roadside diners evolved from converted horse-drawn lunch wagons of the 1890s that served late-night shift workers hot coffee and pie." },
        { id: 81, cat: "SMILES & MUSIC", topic: "Music Lowers Heart Rates", fact: "Listening to mellow classical symphony or acoustic melodies has been clinically proven to lower blood pressure and release soothing endorphins." },
        { id: 82, cat: "FAMILY CURIOSITY", topic: "Laughter Truly Is Medicine", fact: "A good belly laugh exercises the diaphragm, contracts abdominal muscles, and increases oxygen-rich blood flow throughout the body." },
        { id: 83, cat: "FAMILY CURIOSITY", topic: "Smell Triggers Vivid Memories", fact: "Because the olfactory bulb connects directly to the brain's memory centers, the scent of grandma's apple pie can trigger instant childhood memories." },
        { id: 84, cat: "SMILES & MUSIC", topic: "Singing in a Choir", fact: "Studies show that when people sing together in harmony, their heartbeats naturally synchronize and beat to the same rhythm." },
        { id: 85, cat: "FAMILY CURIOSITY", topic: "The Smiling Muscle", fact: "Smiling, even when done intentionally, prompts the brain to release dopamine and serotonin, brightening your mood within seconds." },
        { id: 86, cat: "FAMILY CURIOSITY", topic: "Clouds Weigh Thousands of Tons", fact: "An average fluffy white cumulus cloud weighs approximately 1.1 million pounds—held gracefully aloft by warm rising air currents." },
        { id: 87, cat: "SMILES & MUSIC", topic: "Vivaldi's Four Seasons", fact: "Antonio Vivaldi wrote poetic sonnets directly into his musical sheet scores describing barking dogs in spring and crackling fires in winter." },
        { id: 88, cat: "FAMILY CURIOSITY", topic: "Yawning is Compassionate", fact: "Contagious yawning between family members and pets is linked to empathy and strong social bonds of affection." },
        { id: 89, cat: "FAMILY CURIOSITY", topic: "Bananas Grow Upside Down", fact: "Bananas grow towards the sun through a process called negative geotropism, causing the cheerful yellow bunch to curve upwards." },
        { id: 90, cat: "SMILES & MUSIC", topic: "Beethoven's Resilient Joy", fact: "Ludwig van Beethoven composed his majestic Ninth Symphony ('Ode to Joy') when completely deaf, feeling the vibrations through the piano wood." },
        { id: 91, cat: "FAMILY CURIOSITY", topic: "A Hug Boosts Oxytocin", fact: "A warm 20-second hug releases oxytocin, calming anxiety, comforting the heart, and strengthening family trust." },
        { id: 92, cat: "FAMILY CURIOSITY", topic: "The World's Quietest Place", fact: "An anechoic chamber at Orfield Labs in Minnesota is so quiet (-20.6 decibels) that you can clearly hear your own heartbeat and lungs breathing." },
        { id: 93, cat: "SMILES & MUSIC", topic: "Louis Armstrong's Golden Trumpet", fact: "Louis Armstrong's warm gravelly vocals and brilliant jazz trumpet improvisation popularized scat singing across the globe in 1926." },
        { id: 94, cat: "FAMILY CURIOSITY", topic: "Grandparents Build Resilient Kids", fact: "Children who grow up with active, loving relationships with their grandparents demonstrate higher empathy, kindness, and emotional resilience." },
        { id: 95, cat: "FAMILY CURIOSITY", topic: "Crickets Are Thermometers", fact: "Count a snowy tree cricket's chirps in 15 seconds and add 40: the result gives the exact outdoor temperature in Fahrenheit (Dolbear's Law)." },
        { id: 96, cat: "SMILES & MUSIC", topic: "George Gershwin's Train Rhythm", fact: "George Gershwin conceived his famous 'Rhapsody in Blue' while riding a train from New York to Boston, inspired by the rhythmic clatter of steel rails." },
        { id: 97, cat: "FAMILY CURIOSITY", topic: "Apples Float in Water", fact: "Apples float happily in a bucket of fresh water because 25% of their total volume consists of tiny air pockets." },
        { id: 98, cat: "FAMILY CURIOSITY", topic: "Houseplants Clean the Air", fact: "NASA clean air studies found that simple houseplants like spider plants and peace lilies absorb airborne toxins and produce fresh oxygen." },
        { id: 99, cat: "SMILES & MUSIC", topic: "The Oldest Flute in History", fact: "The oldest known musical instrument is a 40,000-year-old flute carved carefully from a vulture wing bone discovered in Hohle Fels cave." },
        { id: 100, cat: "FAMILY CURIOSITY", topic: "Sunlight Boosts Vitamin D", fact: "Just 15 minutes of gentle morning sunshine on your face and hands naturally synthesizes vital Vitamin D, uplifting your spirits for the day!" },
    ]
end function
